# =============================================================================
# RMASC OnSite — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs réelles
# cp .env.example .env

# ─── Serveur ───────────────────────────────────────────────────────────
PORT=4002

# ─── PostgreSQL / PostGIS ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rmasc_onsite
DB_USER=rmasc
DB_PASSWORD=changeme

# ─── JWT (Authentification) ─────────────────────────────────────────────
JWT_SECRET=rmasc-onsite-jwt-secret-change-me

# ─── ERP (Usine / Gestion de production) ───────────────────────────────
# L'ERP appelle ce webhook quand une commande (ascenseur) est fabriquée
# Le secret doit être le même côté ERP et côté RMASC OnSite
ERP_WEBHOOK_SECRET=changeme

# ─── SMS automatiques ──────────────────────────────────────────────────
# SMS_PROVIDER=simulation  → aucun SMS réel (les SMS sont loggés + marqués envoyés)
# SMS_PROVIDER=twilio      → envoi réel via Twilio
SMS_PROVIDER=simulation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── GeoFlotte GPS (API REST) ───────────────────────────────────────────
# API key fournie par GeoFlotte — active le polling temps réel.
# Sans cette clé, le mode manuel reste actif (positions mises à jour manuellement).
# Documentation : serviceweb.pdf — Service Web GeoFlotte
GEOFLOTTE_API_KEY=
GEOFLOTTE_BASE_URL=https://services.geoflotte.com
GEOFLOTTE_INTERVALLE_MS=60000
